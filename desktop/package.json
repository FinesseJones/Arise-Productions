{
  "name": "arise-production-desktop",
  "version": "1.0.0",
  "description": "Arise Production - A Product of THE AI CONTENT FOUNDRY, LLC",
  "author": "THE AI CONTENT FOUNDRY, LLC",
  "license": "UNLICENSED",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "setup": "node download-electron.js",
    "prebuild": "rm -rf ui backend server.js && cp -R ../frontend/dist ./ui && cp -R ../backend ./backend && cp ../server.js ./server.js",
    "start": "node download-electron.js && electron .",
    "build:mac": "npm run prebuild && electron-builder --mac dmg",
    "build:win": "npm run prebuild && electron-builder --win",
    "build:linux": "npm run prebuild && electron-builder --linux"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "dotenv": "^16.4.7",
    "cors": "^2.8.5",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "llc.aicontentfoundry.ariseproduction",
    "productName": "Arise Production",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "asarUnpack": [
      "server.js",
      "backend/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ]
    },
    "dmg": {
      "title": "Arise Production Installer",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis"]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["AppImage", "deb"]
    },
    "files": [
      "main.js",
      "preload.cjs",
      "server.js",
      "backend/**/*",
      "ui/**/*",
      "build/**/*"
    ]
  }
}
