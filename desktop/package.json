{
  "name": "arise-production-desktop",
  "version": "1.0.0",
  "description": "Arise Production - A Product of THE AI CONTENT FOUNDRY, LLC",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "setup": "node download-electron.js",
    "start": "node download-electron.js && electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "llc.aicontentfoundry.ariseproduction",
    "productName": "Arise Production",
    "mac": {
      "category": "public.app-category.video",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    },
    "files": [
      "main.js",
      "preload.js",
      "../server.js",
      "../backend/**/*",
      "../frontend/dist/**/*"
    ]
  }
}
