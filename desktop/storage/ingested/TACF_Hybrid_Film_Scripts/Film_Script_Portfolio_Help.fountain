    "name": "break_down_character_arc",
    "description": "Creates a 3-act transformation arc for a given character",
    "inputs": ["character_name", "traits", "starting belief", "final belief"]
  },
  {
    "name": "analyze_existing_script",
    "description": "Reviews an uploaded script and maps it to Save the Cat structure",
    "inputs": ["script_file"]
  },
  {
    "name": "generate_treatment",
    "description": "Writes a 1-3 page treatment based on story summary or novel",
    "inputs": ["source_text", "format_type"]
  }
]
```

