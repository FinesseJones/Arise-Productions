{
  "name": "arise-productions",
  "version": "1.0.0",
  "description": "Arise Production - A Product of THE AI CONTENT FOUNDRY, LLC",
  "type": "module",
  "packageManager": "npm",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run --prefix frontend dev",
    "server": "node server.js",
    "build": "npm run --prefix frontend build",
    "preview": "npm run --prefix frontend preview",
    "desktop": "npm start --prefix desktop",
    "desktop:build": "npm run build --prefix frontend && npm run build:mac --prefix desktop",
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend && npm install --prefix desktop",
    "clean": "rm -rf frontend/node_modules backend/node_modules frontend/dist",
    "typecheck": "npm run --prefix frontend typecheck"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^4.0.2",
    "@stripe/stripe-js": "^7.9.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react-hot-toast": "^2.6.0",
    "stripe": "^18.5.0"
  },
  "keywords": [
    "arise-production",
    "3d",
    "production-studio",
    "ai-content-foundry",
    "mcp",
    "react",
    "typescript",
    "three.js",
    "unreal-engine-ready"
  ],
  "author": "THE AI CONTENT FOUNDRY, LLC",
  "license": "UNLICENSED"
}
